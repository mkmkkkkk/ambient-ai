# Ambient AI Configuration
# Copy this to .env and fill in your values

# Assistant name (default: Ambient)
ASSISTANT_NAME=Ambient

# --- Speech-to-Text Backend ---
# Options: soniox (default), whisper, groq
#
#   soniox  — Best for bilingual EN/CN. Mid-sentence code-switching.
#             Speaker diarization included. ~$0.10/hr. Files up to 1GB.
#   whisper — OpenAI Whisper API. Single-language per segment.
#             ~$0.36/hr. 25MB file limit (auto-split for WAV).
#   groq    — Groq-hosted Whisper. Cheapest at ~$0.04/hr.
#             216x realtime speed. Same language limits as Whisper.
STT_BACKEND=soniox

# Soniox API key (for soniox backend)
# Get one at: https://console.soniox.com
SONIOX_API_KEY=

# OpenAI API key (for whisper backend)
# Get one at: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Groq API key (for groq backend)
# Get one at: https://console.groq.com/keys
GROQ_API_KEY=

# Directory to watch for audio files (default: data/audio-inbox)
# Drop .wav, .mp3, .m4a, .ogg, .webm, .flac, or .txt files here
AMBIENT_INBOX_DIR=data/audio-inbox

# Container image (default: nanoclaw-agent:latest)
CONTAINER_IMAGE=nanoclaw-agent:latest

# Container timeout in ms (default: 1800000 = 30 min)
CONTAINER_TIMEOUT=1800000

# Max concurrent containers (default: 5)
MAX_CONCURRENT_CONTAINERS=5

# Timezone (default: system timezone)
# TZ=America/Los_Angeles
